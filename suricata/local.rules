alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"FYP-SCAN: Nmap SYN Port Scan"; flags:S,12; threshold: type threshold, track by_src, count 20, seconds 3; classtype:network-scan; sid:9000001; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"FYP-BRUTE: SSH Brute Force Attempt"; flow:to_server,established; content:"SSH"; depth:3; threshold: type both, track by_src, count 5, seconds 60; classtype:attempted-admin; sid:9000002; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FYP-SQLI: SQL Injection OR 1=1"; flow:to_server,established; http.uri; content:"OR"; nocase; content:"1=1"; nocase; distance:1; classtype:web-application-attack; sid:9000003; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FYP-SQLI: SQL Injection UNION SELECT"; flow:to_server,established; http.uri; content:"UNION"; nocase; content:"SELECT"; nocase; distance:1; classtype:web-application-attack; sid:9000004; rev:1;)
alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"FYP-DOS: ICMP Flood Attack Detected"; itype:8; threshold: type threshold, track by_src, count 100, seconds 1; classtype:attempted-dos; sid:9000005; rev:1;)
alert dns $EXTERNAL_NET any -> $DNS_SERVERS any (msg:"FYP-RECON: Excessive DNS Queries Enumeration"; threshold: type threshold, track by_src, count 50, seconds 10; classtype:network-scan; sid:9000006; rev:1;)
alert http $HOME_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"FYP-WEBSHELL: PHP Web Shell cmd Parameter Access"; flow:to_server,established; http.uri; content:".php"; content:"cmd="; distance:0; classtype:web-application-attack; sid:9000007; rev:1;)
alert dns $EXTERNAL_NET any -> $DNS_SERVERS any (msg:"FYP-RECON: DNS Zone Transfer AXFR Attempt"; dns.query; content:"|00 FC|"; classtype:network-scan; sid:9000008; rev:1;)
